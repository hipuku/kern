{
  "name": "kern",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./atoms": {
      "types": "./src/atoms/index.ts",
      "default": "./src/atoms/index.ts"
    },
    "./molecules": {
      "types": "./src/molecules/index.ts",
      "default": "./src/molecules/index.ts"
    },
    "./organisms": {
      "types": "./src/organisms/index.ts",
      "default": "./src/organisms/index.ts"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "default": "./src/templates/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/tokens.ts",
      "default": "./src/tokens/tokens.ts"
    },
    "./kern.css": "./src/kern.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "brand",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens": "vite-node scripts/build-tokens.mjs",
    "tokens:check": "vite-node scripts/build-tokens.mjs -- --check",
    "lint": "eslint .",
    "check:links": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
